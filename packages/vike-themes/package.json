{
  "name": "vike-themes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Theme extension: a framework-agnostic core (design tokens -> CSS variables; theme brand + appearance axes) plus per-framework bindings as subpaths (vike-themes/react, and vue/solid later). One package, install and import the subpath for your framework.",
  "dependencies": {
    "chroma-js": "^3.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./config": "./+config.js",
    "./oncreate": "./oncreate.js",
    "./react": "./react/+config.js",
    "./react/hooks": "./react/context.js",
    "./react/ThemeWrapper": "./react/ThemeWrapper.jsx",
    "./vue": "./vue/+config.js",
    "./vue/ThemeWrapper": "./vue/ThemeWrapper.vue"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vike-react": ">=0.6",
    "vike-vue": ">=0.9",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vike-react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vike-vue": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "test:components": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
