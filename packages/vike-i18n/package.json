{
  "name": "vike-i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Localization extension: a framework-agnostic core (a cumulative `messages` contribution point + `locale`, on top of Vike's locale routing) plus per-framework bindings as subpaths (vike-i18n/react, and vue/solid later). One package, install and import the subpath for your framework.",
  "dependencies": {
    "vike-toolbar": "workspace:*"
  },
  "exports": {
    ".": "./index.js",
    "./config": "./+config.js",
    "./plugin": "./plugin.js",
    "./oncreate": "./oncreate.js",
    "./texts": "./texts.js",
    "./translate": "./translate.js",
    "./translator": "./translator.js",
    "./cli": "./cli.js",
    "./react": "./react/+config.js",
    "./react/hooks": "./react/context.js",
    "./react/html": "./react/html.js",
    "./react/LocaleWrapper": "./react/LocaleWrapper.jsx",
    "./vue": "./vue/+config.js",
    "./vue/hooks": "./vue/context.js",
    "./vue/html": "./vue/html.js",
    "./vue/LocaleWrapper": "./vue/LocaleWrapper.vue"
  },
  "bin": {
    "vike-translate": "./bin/vike-translate.js"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30",
    "react": ">=18",
    "react-dom": ">=18",
    "vike": "^0.4.0",
    "vike-react": ">=0.6",
    "vike-vue": ">=0.9",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vike-react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vike-vue": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "test:components": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
