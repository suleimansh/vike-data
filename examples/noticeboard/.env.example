# The app runs with NO secrets: pglite is embedded (no DATABASE_URL), vike-auth prints the
# magic-link URL to the dev console, and mail/push fall back to the dev console/outbox
# transports. Copy to .env and fill in to deliver for real (gemstack#289).

# Mail (Resend) - magic-link and announcement email.
# Get a key at https://resend.com. RESEND_FROM must be a Resend-verified sender; the
# default below is Resend's shared test sender (only delivers to the account owner).
RESEND_API_KEY=
RESEND_FROM=Noticeboard <onboarding@resend.dev>

# Web Push (VAPID) - real browser push. Generate a P-256 keypair with
# `npx web-push generate-vapid-keys`. The public key is what the client subscribes with;
# set both or neither.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com
