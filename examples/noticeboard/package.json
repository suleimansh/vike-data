{
  "name": "app-noticeboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The integrated reference app: a team noticeboard treated as a product, not a demo. Persistent Postgres (pglite + vike-drizzle), auth + rbac + admin, the full UI tier (themes/layouts/toolbar/i18n), and live delivery: publishing an announcement fans out through vike-notifications to mail (Resend), web push (VAPID) and the in-app Bell feed.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.js",
    "db:seed": "tsx db/seed.js",
    "db:reset": "node -e \"import('node:fs').then(fs=>fs.rmSync(new URL('.pgdata',import.meta.url),{recursive:true,force:true}))\"",
    "setup": "pnpm db:migrate && pnpm db:seed",
    "test": "node --test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@universal-orm/core": "workspace:*",
    "@universal-orm/drizzle": "workspace:*",
    "@vike-data/vike-schema": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vike": "^0.4.0",
    "vike-react": "^0.6.0",
    "vike-actions": "workspace:*",
    "vike-admin": "workspace:*",
    "vike-auth": "workspace:*",
    "vike-blocks": "workspace:*",
    "vike-drizzle": "workspace:*",
    "vike-i18n": "workspace:*",
    "vike-layouts": "workspace:*",
    "vike-mail": "workspace:*",
    "vike-notifications": "workspace:*",
    "vike-notifications-mail": "workspace:*",
    "vike-notifications-push": "workspace:*",
    "vike-push": "workspace:*",
    "vike-rbac": "workspace:*",
    "vike-theme-emerald": "workspace:*",
    "vike-themes": "workspace:*",
    "vike-toolbar": "workspace:*",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.2"
  }
}
